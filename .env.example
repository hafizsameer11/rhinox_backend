# Database
DATABASE_URL=mysql://user:password@localhost:3306/rhinoxpay

# App
BASE_URL=https://api.yourdomain.com
ENCRYPTION_KEY=12345678901234567890123456789012

# Tatum (crypto wallets, deposits, webhooks)
# When TATUM_API_KEY is set, wallet creation uses Tatum; set USE_TATUM=false to force local mock wallets.
TATUM_API_KEY=
TATUM_BASE_URL=https://api.tatum.io/v3
TATUM_V4_BASE_URL=https://api.tatum.io/v4
TATUM_WEBHOOK_URL=https://api.yourdomain.com/api/crypto/webhooks/tatum
USE_TATUM=true

# PalmPay (fiat — not Tatum)
PALMPAY_WEBHOOK_URL=https://api.yourdomain.com/api/webhooks/palmpay
