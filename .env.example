# Email / OTP (required for registration verification and password reset)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-app-password
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Rhinox Pay

# Database
DATABASE_URL=mysql://user:password@localhost:3306/rhinoxpay

# App
BASE_URL=https://api.yourdomain.com
ENCRYPTION_KEY=12345678901234567890123456789012

# Tatum (legacy crypto wallets — kept in codebase, not used when Busha is live)
# When TATUM_API_KEY is set, wallet creation uses Tatum unless Busha is enabled.
# Set USE_TATUM=true to force Tatum even when BUSHA_API_KEY is present.
TATUM_API_KEY=
TATUM_BASE_URL=https://api.tatum.io/v3
TATUM_V4_BASE_URL=https://api.tatum.io/v4
TATUM_WEBHOOK_URL=https://api.yourdomain.com/api/crypto/webhooks/tatum
USE_TATUM=false

# Busha (live crypto custody + NGN ramp). Production is the default.
BUSHA_API_KEY=
BUSHA_ENVIRONMENT=production
BUSHA_BASE_URL=https://api.busha.so
BUSHA_WEBHOOK_SECRET=
BUSHA_WEBHOOK_URL=https://backend.rhinoxpay.com/api/webhooks/busha
USE_BUSHA=true

# PalmPay (fiat — Nigeria NGN bank deposit/withdraw)
PALMPAY_WEBHOOK_URL=https://api.yourdomain.com/api/webhooks/palmpay

# Flutterwave (mobile money for KE/GH/UG/TZ; NG bill payments: airtime/data/electricity/cable/internet)
# Fund the Flutterwave NGN wallet — bill create debits FLW balance, not PalmPay.
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
FLW_SECRET_HASH=
FLW_BASE_URL=https://api.flutterwave.com
FLW_ENVIRONMENT=sandbox
